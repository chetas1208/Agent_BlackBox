# ─── Agent Black Box — Environment Variables ───────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── Redis ──────────────────────────────────────────────────────
# Option A: Use Redis Cloud (recommended for production)
ABB_REDIS_URL=redis://default:<password>@<host>:<port>

# Option B: Use local Redis (start with: docker compose --profile local-redis up)
# ABB_REDIS_URL=redis://redis:6379

# ── OpenAI ─────────────────────────────────────────────────────
ABB_OPENAI_API_KEY=sk-...
ABB_OPENAI_MODEL=gpt-4o-mini
ABB_LLM_MAX_ITERATIONS=30

# ── Blaxel Sandbox ─────────────────────────────────────────────
BL_WORKSPACE=your-workspace-name
BL_API_KEY=bl_...

# Sandbox profile: "blaxel" for real execution, "local_mock" for demo
ABB_SANDBOX_PROFILE=blaxel

# ── App ────────────────────────────────────────────────────────
ABB_DEBUG=false
ABB_CORS_ORIGINS=["http://localhost:3000"]
ABB_AGENT_STEP_DELAY_MS=500

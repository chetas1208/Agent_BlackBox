# Backend
ABB_REDIS_URL=redis://localhost:6379
ABB_DEBUG=true
ABB_CORS_ORIGINS=["http://localhost:3000"]
ABB_AGENT_STEP_DELAY_MS=800

# Sandbox profile: blaxel | local_mock
ABB_SANDBOX_PROFILE=local_mock

# Blaxel (https://blaxel.ai)
BL_WORKSPACE=your-workspace
BL_API_KEY=your-blaxel-api-key

# OpenAI
ABB_OPENAI_API_KEY=sk-...
ABB_OPENAI_MODEL=gpt-4o-mini
ABB_LLM_MAX_ITERATIONS=30

# Frontend
NUXT_PUBLIC_API_BASE=http://localhost:8000
